<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="PortalRastreamentoPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>br.upf.portalrastreamento.entity.UsuarioEntity</class>
        <class>br.upf.portalrastreamento.entity.ClienteEntity</class>
        <class>br.upf.portalrastreamento.entity.TransportadoraEntity</class>
        <class>br.upf.portalrastreamento.entity.PedidoEntity</class>
        <class>br.upf.portalrastreamento.entity.HistoricoPedidoEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- AJUSTE AQUI: banco, usuario e senha do SEU Postgres -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/portal_rastreamento"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="SUA_SENHA"/>

            <!-- Sem cache compartilhado: sempre le o que esta no banco -->
            <property name="eclipselink.cache.shared.default" value="false"/>
            <property name="eclipselink.logging.level" value="INFO"/>
        </properties>
    </persistence-unit>
</persistence>
